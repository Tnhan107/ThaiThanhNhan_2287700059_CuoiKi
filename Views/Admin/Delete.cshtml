@model Course

@{
    ViewData["Title"] = "Delete Course";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Admin</p>
        <h1>Delete Course</h1>
        <p class="page-subtitle">Xác nhận xóa học phần khỏi hệ thống.</p>
    </div>
</section>

<section class="content-panel danger-panel">
    <h2>@Model.Name</h2>
    <dl class="row mb-4">
        <dt class="col-sm-3">Danh mục</dt>
        <dd class="col-sm-9">@Model.Category?.Name</dd>
        <dt class="col-sm-3">Số tín chỉ</dt>
        <dd class="col-sm-9">@Model.Credits</dd>
        <dt class="col-sm-3">Giảng viên</dt>
        <dd class="col-sm-9">@Model.Lecturer</dd>
    </dl>
    <form method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger">Delete</button>
        <a class="btn btn-outline-secondary" asp-action="Courses">Cancel</a>
    </form>
</section>
